APP_NAME=Telegram Drone Safety Monitor
DEBUG=false
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram collector is disabled by default so the API/UI can start immediately.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_sessions/drone_monitor

# OpenRouter. If empty, backend uses a local heuristic fallback for development.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Geocoder. For Russia, Yandex is recommended when an API key is available.
GEOCODER_PROVIDER=nominatim
YANDEX_GEOCODER_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=telegram-drone-safety-monitor/0.1

# Comma-separated webhook URLs for immediate event delivery.
WEBHOOK_URLS=

# Frontend build-time API URL.
VITE_API_BASE=http://localhost:8000/api
