APP_NAME=Telegram Drone Safety Monitor
DEBUG=false
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram collector is disabled by default so the API/UI can start immediately.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=telegram_sessions/drone_monitor
# Optional authenticated HTTP CONNECT proxy for Telegram traffic.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=0
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_POLL_ENABLED_SOURCES=true
TELEGRAM_POLL_INTERVAL_SECONDS=300
TELEGRAM_POLL_LIMIT_PER_SOURCE=100
TELEGRAM_POLL_MAX_PAGES_PER_SOURCE=10
TELEGRAM_COMMENTS_SAFETY_SCAN_SECONDS=600
TELEGRAM_COMMENTS_MAX_CONCURRENCY=2
TELEGRAM_COMMENTS_DUE_BATCH_SIZE=20
TELEGRAM_COMMENTS_MAX_PER_POLL=500
TELEGRAM_COMMENTS_MIN_INTERVAL_SECONDS=15

# OpenRouter. If empty, backend uses a local heuristic fallback for development.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_MAX_CONCURRENCY=8

# Geocoder. For Russia, Yandex is recommended when an API key is available.
GEOCODER_PROVIDER=nominatim
YANDEX_GEOCODER_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=telegram-drone-safety-monitor/0.1
NOMINATIM_MIN_INTERVAL_SECONDS=1.05
YANDEX_GEOCODER_MAX_CONCURRENCY=3
GEOCODER_CACHE_SIZE=2000

# Comma-separated webhook URLs for immediate event delivery.
WEBHOOK_URLS=
WEBHOOK_MAX_CONCURRENCY=5
